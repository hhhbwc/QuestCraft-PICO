# ============================================================
# QuestCraft-PICO — root .gitignore
# Unity (QCXR-XR-Wrapper) + Gradle/Android (Pojlib)
#
# NOTE: this repo intentionally COMMITS required binaries
# (LWJGL jars, the JRE-25.zip runtime, native .so/.dll/.aar,
# *.bin mod/runtime assets). Do NOT add global *.jar/*.zip/
# *.so/*.bin/*.aar ignores — they would break the build.
# ============================================================

# ---------- Unity build outputs ----------
**/[Ll]ibrary/
**/[Tt]emp/
**/[Ll]ogs/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/MemoryCaptures/
**/[Uu]serSettings/Layouts/
**/AssetStoreTools*

# ---------- Autogenerated IDE / OS files ----------
*.csproj
*.unityproj
*.sln
*.sln.meta
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.swo
*.bak
*~
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Gradle / Android build outputs ----------
.gradle/
**/build/
local.properties
*.iml
.idea/

# ---------- Logs / local output ----------
logs/
/out/
# Local audit artifacts (device logs, screenshots, extracted APKs)
/audit/
# Built AAR is produced by build.ps1; do not commit it
QCXR-XR-Wrapper/Assets/Plugins/Android/Pojlib-release.aar

# ---------- Android build artifacts (generated) ----------
*.apk

# Keep required binary assets (override nothing above)
# (no global ignores for *.jar/*.zip/*.so/*.bin/*.aar/*.dll — all needed)
